{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "green_agent_qa_mode": {
        "type": "string"
      },
      "green_agent_transcript_dir": {
        "type": "string"
      },
      "green_openai_api_key": {
        "type": "string",
        "secret": true
      },
      "rita_anthropic_api_key": {
        "type": "string",
        "secret": true,
        "default": ""
      },
      "rita_azure_openai_api_version": {
        "type": "string",
        "description": "Azure OpenAI API version",
        "default": "2025-04-01-preview"
      },
      "rita_azure_openai_endpoint": {
        "type": "string",
        "description": "Azure OpenAI endpoint URL (e.g. https://your-resource.openai.azure.com/). Leave empty for standard OpenAI.",
        "default": ""
      },
      "rita_cheap_model_name": {
        "type": "string",
        "description": "Fast/cheap LLM model for classification and simple tasks",
        "default": "gpt-4o-mini"
      },
      "rita_gemini_api_key": {
        "type": "string",
        "secret": true,
        "default": ""
      },
      "rita_model_name": {
        "type": "string",
        "description": "Primary LLM model for complex reasoning tasks",
        "default": "gpt-5.4"
      },
      "rita_openai_api_key": {
        "type": "string",
        "secret": true,
        "default": ""
      }
    },
    "required": [
      "green_openai_api_key",
      "green_agent_qa_mode",
      "green_agent_transcript_dir"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.1/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "list1_path": "/home/agent/data/List1_FINAL_stimuli_list.csv",
          "list2_path": "/home/agent/data/List2_FINAL_stimuli_list.csv"
        },
        "participant_roles": {
          "green": "green",
          "purple1": "rita"
        },
        "callback_urls": {
          "green": "${bindings.green-proxy.url}",
          "purple1": "${bindings.purple1-proxy.url}"
        }
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/build_what_i_mean-agentbeats/refs/heads/main/amber/amber-manifest-green.json5",
      "config": {
        "agent_qa_mode": "${config.green_agent_qa_mode}",
        "agent_transcript_dir": "${config.green_agent_transcript_dir}",
        "openai_api_key": "${config.green_openai_api_key}"
      }
    },
    "rita": {
      "manifest": "https://raw.githubusercontent.com/paulwhitten/AgentWhetters-dispatch-general-purple/refs/heads/main/amber-manifest.json5",
      "config": {
        "anthropic_api_key": "${config.rita_anthropic_api_key}",
        "azure_openai_api_version": "${config.rita_azure_openai_api_version}",
        "azure_openai_endpoint": "${config.rita_azure_openai_endpoint}",
        "cheap_model_name": "${config.rita_cheap_model_name}",
        "gemini_api_key": "${config.rita_gemini_api_key}",
        "model_name": "${config.rita_model_name}",
        "openai_api_key": "${config.rita_openai_api_key}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#rita.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "green-proxy"
    },
    {
      "to": "#rita.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "purple1-proxy"
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019caf3f-5549-7731-a213-5e4ca0554cb7",
      "rita": "019e5ad0-cc7e-70f2-8a37-32f76d63b641"
    }
  }
}