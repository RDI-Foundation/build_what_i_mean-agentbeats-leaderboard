{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "green_agent_qa_mode": {
        "type": "string"
      },
      "green_agent_transcript_dir": {
        "type": "string"
      },
      "green_openai_api_key": {
        "type": "string",
        "secret": true
      },
      "rita_gemini_api_key": {
        "type": "string",
        "secret": true,
        "description": "Gemini API key used only as fallback."
      },
      "rita_gemini_model": {
        "type": "string",
        "description": "Gemini fallback model."
      },
      "rita_local_llm_api_key": {
        "type": "string",
        "secret": true,
        "description": "Bearer token for the secure local LLM proxy."
      },
      "rita_public_local_llm_base_url": {
        "type": "string",
        "description": "Public OpenAI-compatible local cluster model endpoint, ending with /v1."
      },
      "rita_public_local_llm_model": {
        "type": "string",
        "description": "Model name served by the public local endpoint."
      }
    },
    "required": [
      "green_openai_api_key",
      "green_agent_qa_mode",
      "green_agent_transcript_dir",
      "rita_public_local_llm_base_url",
      "rita_public_local_llm_model",
      "rita_local_llm_api_key",
      "rita_gemini_api_key",
      "rita_gemini_model"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.1/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "list1_path": "/home/agent/data/List1_FINAL_stimuli_list.csv",
          "list2_path": "/home/agent/data/List2_FINAL_stimuli_list.csv"
        },
        "participant_roles": {
          "green": "green",
          "purple1": "rita"
        },
        "callback_urls": {
          "green": "${bindings.green-proxy.url}",
          "purple1": "${bindings.purple1-proxy.url}"
        }
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/build_what_i_mean-agentbeats/refs/heads/main/amber/amber-manifest-green.json5",
      "config": {
        "agent_qa_mode": "${config.green_agent_qa_mode}",
        "agent_transcript_dir": "${config.green_agent_transcript_dir}",
        "openai_api_key": "${config.green_openai_api_key}"
      }
    },
    "rita": {
      "manifest": "https://raw.githubusercontent.com/Kingmaoqin/DHAI_AgenticAI/main/amber-manifest.json5",
      "config": {
        "gemini_api_key": "${config.rita_gemini_api_key}",
        "gemini_model": "${config.rita_gemini_model}",
        "local_llm_api_key": "${config.rita_local_llm_api_key}",
        "public_local_llm_base_url": "${config.rita_public_local_llm_base_url}",
        "public_local_llm_model": "${config.rita_public_local_llm_model}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#rita.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "green-proxy"
    },
    {
      "to": "#rita.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "purple1-proxy"
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019caf3f-5549-7731-a213-5e4ca0554cb7",
      "rita": "019e52c3-7764-76b1-bfcb-a0c3d584d964"
    }
  }
}